# Auto-CRM - Variables de Entorno
# Copia este archivo como .env.local: cp .env.example .env.local

# =============================================================================
# SUPABASE (requerido para la versión online)
# Panel Supabase > Settings > API
# =============================================================================
# NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# NEXT_PUBLIC_SITE_URL=https://crm-trino-production.up.railway.app
# SUPABASE_SERVICE_ROLE_KEY=eyJ...   (solo para scripts de seed/migración)
# SUPABASE_ORG_ID=<UUID>             (SELECT id FROM organizations LIMIT 1)
# SUPABASE_USER_ID=<UUID>            (SELECT id FROM auth.users LIMIT 1)

# =============================================================================
# RECOMENDADO: Rate limiting (protege /api/webhook, /api/auth y el resto de
# /api/* contra floods y fuerza bruta). Cuenta gratis en upstash.com >
# Create Database > copia "REST URL" y "REST Token".
# Sin esto configurado, el rate limiting queda deshabilitado (no bloquea).
# =============================================================================
# UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=AxxxA...

# =============================================================================
# RECOMENDADO: Cifrado de los links de firma externa (migracion 104).
# Sin esto, un link de firma solo se puede copiar en el momento de crearlo:
# en la base vive el SHA-256 del token, no el token. Con esto configurado,
# ademas se guarda el token cifrado (AES-256-GCM) con esta llave -- que vive
# aca, NO en la base -- y aparece el boton "Copiar link" en la ficha del
# evento.
# Generar con: openssl rand -base64 48
# OJO: si se cambia, los links ya emitidos dejan de poder copiarse (siguen
# funcionando para firmar; solo hay que emitir uno nuevo para compartirlos).
# =============================================================================
# LINK_TOKEN_SECRET=<48+ bytes aleatorios en base64>

# =============================================================================
# OPCIONAL: API de Claude para clasificacion de leads con IA
# Si no se configura, el CRM usa scoring basado en reglas (funciona igual de bien)
# =============================================================================
# ANTHROPIC_API_KEY=sk-ant-...

# Usado para leer pantallazos de Spotify y sugerir el mapeo de columnas del
# importador masivo (modelo gpt-4.1-mini — barato, soporta visión).
# OPENAI_API_KEY=sk-...

# =============================================================================
# OPCIONAL: Email digest diario (registrate gratis en resend.com)
# =============================================================================
# RESEND_API_KEY=re_...
# DIGEST_EMAIL=tu@email.com
# DIGEST_FROM=Auto-CRM <onboarding@resend.dev>

# =============================================================================
# CRON: sync diario de Instagram (4am) — /api/cron/sync-instagram
# Genera un secret random (ej: openssl rand -hex 32) y configuralo también
# en el Railway Cron Job que llama a este endpoint.
# =============================================================================
# CRON_SECRET=

# =============================================================================
# SHOPIFY (Merch) — app OAuth en Shopify Partners
# Creala en partners.shopify.com > Apps > Crear app, distribución "Custom" o
# "Public" sin publicar en el App Store (no requiere revisión de Shopify
# mientras no se liste públicamente) — necesario porque a futuro otros
# artistas van a conectar sus propias tiendas, no solo la de Katarsis.
# Scopes a configurar: read_products, read_inventory, read_orders.
# Redirect URL a registrar en el Partner Dashboard:
#   https://artistpro.app/api/integrations/shopify/callback
# =============================================================================
# SHOPIFY_API_KEY=
# SHOPIFY_API_SECRET=
# SHOPIFY_REDIRECT_URI=https://artistpro.app/api/integrations/shopify/callback

# =============================================================================
# CRON: sync diario de Shopify (Merch) — /api/cron/sync-shopify
# Reusa el mismo CRON_SECRET de arriba. El access token de cada tienda NO
# vive en variables de entorno — se guarda por proyecto en artist_integrations
# (platform='shopify') al conectar desde la UI (Métricas > Merch).
# =============================================================================

# =============================================================================
# WEB PUSH (notificaciones cuando te asignan una tarea)
# Generar el par de claves una sola vez con: npx web-push generate-vapid-keys
# La publica va tal cual (NEXT_PUBLIC_) porque el navegador la necesita para
# suscribirse -- la privada NUNCA se expone, solo la usa el server para firmar
# el envio.
# =============================================================================
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:tu@email.com

# =============================================================================
# DOMINIO CORTO PARA QR / LINKS (opcional) — ej. si se compra artspr.cl para
# usarlo como acortador en vez de artistpro.app/q/xxx.
# 1. Comprar el dominio (NIC Chile para .cl, o el registrador que sea).
# 2. Apuntarlo a Railway: en el proyecto de Railway, Settings del servicio
#    > Networking > Custom Domain, agregar el dominio y crear el registro
#    DNS (CNAME o A, Railway indica cuál) en el panel del registrador.
# 3. Pegar el dominio acá (sin https://, sin barra al final) y listo -- no
#    hace falta redeploy de código, la reescritura ya está lista.
# Soporta más de uno separados por coma (ej. si se agrega también www).
# =============================================================================
# SHORT_LINK_DOMAINS=artspr.cl

# =============================================================================
# GOOGLE MAPS (autocompletar dirección de Venues) — todavía no conectado.
# El módulo de Venues (Eventos > Venue) funciona hoy con dirección escrita a
# mano. Para activar el autocompletado con Google Places:
#   1. Crear un proyecto en console.cloud.google.com (o reusar uno).
#   2. Habilitar "Places API (New)" y activar billing (tiene cuota gratis
#      mensual, cobra solo por sobre-uso).
#   3. Crear una API key restringida a Places API (New), sin restricción de
#      referrer ya que se usa server-side (nunca se expone al navegador).
#   4. Pegarla aca abajo y avisar -- ahi se conecta el autocompletado sin
#      tocar el resto del módulo.
# =============================================================================
# GOOGLE_MAPS_API_KEY=

# =============================================================================
# META CONVERSIONS API (campañas de Meta Ads sobre links de /q/[slug])
# Events Manager > tu Pixel > Configuración > Conversions API > Generar
# token de acceso.
# Fallback global si un proyecto no tiene su propio pixel/token en
# artist_integrations (platform='meta_capi', account_id=pixel_id,
# access_token=token) -- ver src/lib/meta-capi.ts.
# =============================================================================
# META_PIXEL_ID=
# META_CAPI_TOKEN=
# Opcional -- Events Manager > Pixel > Prueba de eventos, te da un código
# temporal para ver los eventos llegar en vivo antes de sacarlo a
# producción. Sacar esta variable (o dejarla vacía) una vez validado.
# META_TEST_EVENT_CODE=

# =============================================================================
# BOT DE META ADS (optimiza la campaña CP_LUR — /api/cron/meta-ads-bot cada 6h
# y /api/cron/meta-ads-summary 1x/día 12:00 UTC ≈ 9:00 Santiago). Reusa el
# mismo CRON_SECRET de arriba en ambos endpoints.
# =============================================================================
# Token de system user con permiso ads_management/ads_read sobre la cuenta.
# META_SYSTEM_TOKEN=
# Cuenta de ads (default en código: act_1734662137756560 = CP_LUR).
# META_AD_ACCOUNT_ID=act_1734662137756560
# Slug del qr_code de la campaña: de ahí sale el project_id y los spotify_clicks.
# BOT_SPOTIFY_QR_SLUG=lur-dopamina
# El bot SOLO mira campañas cuyo nombre empiece con estos prefijos (coma-separados).
# Default en código: LUR_DOPA_TEST_TRAF,LUR_DOPA_ESCALA_TRAF
# BOT_CAMPAIGN_PREFIXES=LUR_DOPA_TEST_TRAF,LUR_DOPA_ESCALA_TRAF
# Interruptores. Arranca DESACTIVADO y en DRY-RUN (seguro): evalúa, registra en
# ad_actions_log y avisa por Telegram, pero NO escribe en Meta.
# BOT_ENABLED=false
# BOT_DRY_RUN=true
# Plan diario total en CLP (tope global). Sin esto, la regla de SUBIR
# presupuesto queda inactiva (comportamiento seguro).
# BOT_DAILY_BUDGET_CAP_CLP=5500
# Alertas por Telegram (@BotFather -> /newbot; chat_id via getUpdates).
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# =============================================================================
# REPORTE READ-ONLY de la campaña — GET /api/ads/report?project_id=<uuid>&days=4
# Protegido con header `x-report-key: <ADS_REPORT_KEY>`. Genera un valor random
# (openssl rand -hex 32). Es lo que se usa para los reportes cada 3-4 días.
# =============================================================================
# ADS_REPORT_KEY=

