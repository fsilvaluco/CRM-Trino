MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

- Migración 012: unique constraint pasa de (org, platform) a
  (org, platform, project_id) — antes solo se permitía UNA conexión de
  Instagram por organización y aparecía en todos los proyectos
- status/sync/disconnect ahora filtran por project_id
- Analytics page pasa projectId al endpoint de status
- connect: agrega scope business_management (páginas dentro de
  portafolios comerciales no eran accesibles sin él) y auth_type=rerequest
  (fuerza a Facebook a mostrar el selector de activos en vez de la
  pantalla de Reconectar con la config anterior congelada)
---
 .../012_artist_integrations_per_project.sql   | 40 +++++++++++++++++++
 src/app/analytics/page.tsx                    |  2 +-
 .../api/integrations/meta/callback/route.ts   |  2 +-
 .../api/integrations/meta/connect/route.ts    | 10 ++++-
 .../api/integrations/meta/disconnect/route.ts | 14 +++++--
 src/app/api/integrations/meta/status/route.ts | 16 ++++++--
 src/app/api/integrations/meta/sync/route.ts   |  3 +-
 7 files changed, 77 insertions(+), 10 deletions(-)
 create mode 100644 scripts/migrations/012_artist_integrations_per_project.sql

diff --git a/scripts/migrations/012_artist_integrations_per_project.sql b/scripts/migrations/012_artist_integrations_per_project.sql
new file mode 100644
index 0000000..d10487e
--- /dev/null
+++ b/scripts/migrations/012_artist_integrations_per_project.sql
@@ -0,0 +1,40 @@
+-- Bug: solo se permitía UNA integración de Instagram por organización.
+-- El unique constraint de la migración 010 era (organization_id, platform),
+-- por lo que conectar La Sagrada en el proyecto "Prueba 2" hacía que esa
+-- misma conexión apareciera en TODOS los proyectos (Simplemente Yo, Deni Li,
+-- etc.) — era literalmente el mismo registro.
+--
+-- Fix: el constraint pasa a (organization_id, platform, project_id) para que
+-- cada proyecto tenga su propia conexión de Instagram.
+
+-- 1. Eliminar el constraint antiguo
+ALTER TABLE artist_integrations
+  DROP CONSTRAINT IF EXISTS artist_integrations_org_platform_key;
+
+-- 2. Dedupe por (org, platform, project_id) conservando el más reciente
+DELETE FROM artist_integrations t
+WHERE t.ctid NOT IN (
+  SELECT DISTINCT ON (organization_id, platform, project_id) ctid
+  FROM artist_integrations
+  ORDER BY organization_id, platform, project_id, updated_at DESC NULLS LAST, ctid DESC
+);
+
+-- 3. Crear el nuevo constraint
+DO $$
+BEGIN
+  IF NOT EXISTS (
+    SELECT 1
+    FROM pg_constraint
+    WHERE conrelid = 'artist_integrations'::regclass
+      AND contype = 'u'
+      AND conname = 'artist_integrations_org_platform_project_key'
+  ) THEN
+    ALTER TABLE artist_integrations
+      ADD CONSTRAINT artist_integrations_org_platform_project_key
+      UNIQUE (organization_id, platform, project_id);
+  END IF;
+END $$;
+
+-- Nota: filas con project_id NULL (integraciones conectadas antes de la
+-- migración 011) no participan bien del upsert por proyecto. Limpiarlas:
+DELETE FROM artist_integrations WHERE project_id IS NULL;
